# 도로명주소 검색 API 승인키 (business.juso.go.kr)
JUSO_CONFM_KEY=
JUSO_CONFM_KEY_ALT=
# 공공데이터포털 일반 인증키 (건축HUB 건축물대장, 아파트 실거래가 상세, 공동주택 단지 목록, 상가(상권)정보 공용)
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_APT_TRADE_URL=https://apis.data.go.kr/1613000/RTMSDataSvcAptTradeDev
DATA_GO_KR_APT_LIST_URL=https://apis.data.go.kr/1613000/AptListService4
DATA_GO_KR_SDSC_URL=https://apis.data.go.kr/B553077/api/open/sdsc2
# 브이월드 운영 키 (서비스 URL https://propedia-prototype.vercel.app)
VWORLD_API_KEY=
# 브이월드 개발 키 (서비스 URL localhost:3000)
VWORLD_API_KEY_DEV=
VWORLD_DEV_DOMAIN=http://localhost:3000
# 서버(core/live·pipeline) 브이월드 호출의 domain 파라미터. 비우면 https://propedia-prototype.vercel.app
# 로컬에서 개발 키로 빌드할 때는 http://localhost:3000, 운영 키를 쓸 때는 운영 주소로 맞춘다
VWORLD_DOMAIN=
# 브라우저 배경지도(WMTS) 키 — web/ 빌드 때 번들에 들어간다(서비스 URL 제한에 기댐). 로컬은 개발 키
VITE_VWORLD_KEY=
